diff --git a/VoodooSerial/VoodooUART/VoodooUARTController.cpp b/VoodooSerial/VoodooUART/VoodooUARTController.cpp
index 5094097..aff2233 100644
--- a/VoodooSerial/VoodooUART/VoodooUARTController.cpp
+++ b/VoodooSerial/VoodooUART/VoodooUARTController.cpp
@@ -102,6 +102,8 @@ void VoodooUARTController::startUARTClock() {
         writeRegister(UART_UPDATE_CLK | CALC_CLK(8, 15) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
     else if (device.device_id == 0x9d27)
         writeRegister(UART_UPDATE_CLK | CALC_CLK(2, 5) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
+    else if (device.device_id == 0x51a8) // Alder Lake-P UART0: 100 MHz LPSS clock -> 64 MHz
+        writeRegister(UART_UPDATE_CLK | CALC_CLK(16, 25) | UART_ENABLE_CLK, LPSS_PRIV + LPSS_UART_CLK);
     else
         LOG("Unknown UART type");
 }
